# Connected Newsroom — Caddy Reverse Proxy Configuration
# Journalists access the platform over standard HTTPS.
# Internal databases, Qdrant, Storage, and Ollama are isolated on newsroom_internal network.

{$DOMAIN:localhost} {
    encode zstd gzip

    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), microphone=()"
    }

    reverse_proxy portal:3000
}
